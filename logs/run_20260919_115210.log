import numpy as np
import open3d as o3d


def point_mesh_distances(mesh: o3d.geometry.TriangleMesh, points: np.ndarray) -> np.ndarray:
    """
    Computes distances from points to the element's mesh surface using Open3D RaycastingScene.

    :param mesh: The Open3D TriangleMesh to compute distances to.
    :param points: The point cloud data as a NumPy array.
