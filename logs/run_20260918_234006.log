def distance_score(avg_distance: float | None, tolerance: float) -> float:
    """
    Computes a score based on the average distance of close points to the element's surface.
    The score is higher when the average distance is smaller relative to the tolerance.

    :param avg_distance: The average distance of close points to the element's surface.
    :param tolerance: The tolerance for the surface distance.
    :return: The computed distance score.
    """

    if avg_distance is None:
        return 0.0

    ratio = avg_distance / tolerance

    if ratio <= 0.25:
        return 100.0
