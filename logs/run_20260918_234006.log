"""
This module provides functions for filtering point cloud data based on
bounding boxes and proximity to mesh vertices.
"""

import numpy as np
from scipy.spatial import cKDTree


def build_tree(points: np.ndarray) -> cKDTree:
    """
    Builds a cKDTree from the given point cloud data for efficient spatial queries.

    :param points: A NumPy array of shape (N, 3) representing the point cloud data.
    :return: A cKDTree object built from the point cloud data.
    """
    return cKDTree(points)


def candidate_points_for_vertices(
    points: np.ndarray, tree: cKDTree, vertices: np.ndarray, margin: float
):
    """
    Quick pre-filtering: only points in the vicinity of the element's bounding box.

    :param points: The point cloud data as a NumPy array.
    :param tree: A cKDTree bui
---
[C:\Users\czapm\Desktop\IFCScanVerifier\backend\geometry\bbox_filter.py]
lt from the point cloud data.
    :param vertices: The vertices of the element's mesh as a NumPy array.
    :param margin: The margin to expand the bounding box for candidate point selection.
    :return: A NumPy array of candidate points that are within the expanded bounding box.
    """
    min_bound = vertices.min(axis=0) - margin
    max_bound = vertices.max(axis=0) + margin
    center = (min_bound + max_bound) / 2.0
    radius = np.linalg.norm(max_bound - center)

    candidate_indices = tree.query_ball_point(center, radius)
    candidate_points = points[candidate_indices]

    if len(candidate_points) == 0:
        return candidate_points

    mask = np.all((candidate_points >= min_bound) & (candidate_points <= max_bound), axis=1)
    return candidate_points[mask]

