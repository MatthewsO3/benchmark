def load_e57_points(
    e57_path: str | Path,
    voxel_size: float = 0.05,
    *,
    chunk_size: int = 1_000_000,
    partition_count: int = 64,
    work_dir: str | Path | None = None,
) -> np.ndarray:
    """Load E57 points with bounded scan memory and optional voxel reduction."""
    if chunk_size <= 0:
        raise ValueError("Az E57 chunk méretének pozitívnak kell lennie.")
    if partition_count <= 0:
        raise ValueError("A voxel partíciók számának pozitívnak kell lennie.")

    persistent_directory = Path(work_dir) if work_dir is not None else None
    if persistent_directory is not None:
        persistent_directory.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory(dir=persistent_directory, prefix="e57_chunks_") as temp_name:
        temp_directory = Path(temp_name)
        output_path = (
            persistent_directory / "pointcloud_voxelized.bin"
            if persistent_directory is not None
            else temp_directory / "pointcloud_voxelized.bin"
        )
        output_path.unlink(missing_ok=True)

        if voxel_size > 0.0:
            partition_paths = [
                temp_directory / f"voxel_{index:04d}.bin" for index in range(partition_count)
            ]
            handles = [path.open("wb") for path in partition_paths]
            try:
                with pye57.E57(str(e57_path)) as e57:
                    for scan_index in tqdm(
                        range(e57.scan_count), desc="E57 chunk olvasás", unit="scan"
                    ):
                        for points in iter_e57_xyz_chunks(e57, scan_index, chunk_size):
                            _write_partition_records(handles, points, voxel_size)
            finally:
                for handle in handles:
                    handle.close()

            with output_path.open("wb") as output:
                point_count = _deduplicate_partitions(partition_paths, output)
        else:
            point_count = 0
            with output_path.open("wb") as output, pye57.E57(str(e57_path)) as e57:
                for scan_index in tqdm(
                    range(e57.scan_count), desc="E57 chunk olvasás", unit="scan"
                ):
                    for points in iter_e57_xyz_chunks(e57, scan_index, chunk_size):
                        points.tofile(output)
                        point_count += len(points)

        return _load_output(
            output_path,
            point_count,
            memory_map=persistent_directory is not None,
        )
---
