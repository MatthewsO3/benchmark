"""
This module serves as the entry point for running the Streamlit application.
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def main() -> None:
    """
    Main function to run the Streamlit application.
    It constructs the path to the Streamlit app and executes it using subprocess.
    """

    app_path = Path(__file__).resolve().parent / "frontend" / "app.py"
