def get_classification_ids(element: object) -> list[str]:
    """
    Collects the classification codes associated with an element.
    In IFC2X3, the field is often named ItemReference, while in IFC4, it is named Identification.

    :param element: The IFC element to extract classification codes from.
    :return: A list of classification codes associated with the element.
    """

    ids: list[str] = []
    try:
        associations = getattr(element, "HasAssociations", None)
        if not associations:
            return ids

        for rel in associations:
            if not rel.is_a("IfcRelAssociatesClassification"):
                continue
            ref = rel.RelatingClassification
            for attr in ["Identification", "ItemReference", "Name"]:

