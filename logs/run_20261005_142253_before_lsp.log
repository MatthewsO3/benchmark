"""
This module provides functions to sample points from the surface of an IFC element's mesh and
to compute the coverage ratio of a point cloud over that mesh surface.
It uses Open3D for mesh processing and sampling,
and SciPy's cKDTree for efficient nearest neighbor searches.
"""

import numpy as np
import open3d as o3d
from scipy.spatial import cKDTree


def sample_mesh_surface(mesh: o3d.geometry.TriangleMesh, sample_count: int = 1500) -> np.ndarray:
    """
    Sampling of IFC mesh surface. These sample points are what the point cloud should verify.

