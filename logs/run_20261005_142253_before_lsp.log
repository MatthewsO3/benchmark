from html import escape
from pathlib import Path


def save_html_report(results: list[dict], out_html: str | Path) -> None:
    """
    Saves the verification results to an HTML file.

    :param results: The verification results.
    :param out_html: The path to the output HTML file.
    """

    total = len(results)
    built = sum(1 for r in results if r.get("ScanStatus") == "Beépült")
