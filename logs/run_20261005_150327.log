def run_verification(
    ifc_bytes: bytes,
    e57_bytes: bytes,
    classification_code: str,
    voxel_size: float,
    bbox_margin: float,
    surface_tolerance: float,
):
    """
    Runs the verification pipeline for IFC elements against point cloud data.

    :param ifc_bytes: The IFC file as bytes.
    :param e57_bytes: The E57 file as bytes.
    :param classification_code: The classification code to filter the elements.
    :param voxel_size: The size of the voxels for downsampling.
    :param bbox_margin: The margin to add to the bounding box.
    :param surface_tolerance: The tolerance for surface verification.
    :return: A tuple containing the verification results and the output files.
    """

    with tempfile.TemporaryDirectory() as temp_dir_name:
        temp_dir = Path(temp_dir_name)
        ifc_path = temp_dir / "model.ifc"
        e57_path = temp_dir / "scan.e57"
        out_ifc = temp_dir / "model_scan_verification.ifc"
        out_csv = temp_dir / "scan_verification_report.csv"
        out_html = temp_dir / "scan_verification_report.html"

        ifc_path.write_bytes(ifc_bytes)
        e57_path.write_bytes(e57_bytes)

        points = load_e57_points(
            e57_path,
            voxel_size=voxel_size,
            chunk_size=E57_CHUNK_SIZE,
            partition_count=E57_VOXEL_PARTITIONS,
            work_dir=temp_dir,
        )

        ifc, settings = open_ifc(ifc_path)
        elements = collect_classified_proxy_elements(ifc, classification_code)
        try:
            results = verify_elements(
                settings=settings,
                elements=elements,
                points=points,
                bbox_margin=bbox_margin,
                surface_tolerance=surface_tolerance,
                voxel_size=voxel_size,
            )
        finally:
            close_e57_points(points)

        write_scan_properties(ifc, results, classification_code, surface_tolerance)
        ifc.write(str(out_ifc))
        save_csv_report(results, out_csv)
        save_html_report(results, out_html)

        rows = []
        for row in results:
            rows.append({k: v for k, v in row.items() if k != "element"})

        return rows, out_csv.read_bytes(), out_html.read_bytes(), out_ifc.read_bytes()
