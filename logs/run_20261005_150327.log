"""
This module contains functions to generate and save CSV reports from the verification results.
"""

from pathlib import Path

import pandas as pd


def save_csv_report(results: list[dict], out_csv: str | Path) -> None:
    """
    Saves the verification results to a CSV file.

    :param results: The verification results.
    :param out_csv: The path to the output CSV file.
    """

    rows = []
    for r in results:
        row = {k: v for k, v in r.items() if k != "element" and not k.startswith("_")}
        rows.append(row)
    df = pd.DataFrame(rows)
    df.to_csv(out_csv, index=False, encoding="utf-8-sig")

