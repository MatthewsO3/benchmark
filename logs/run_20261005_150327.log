"""
This module provides functions to compute distances from points to a mesh surface using Open3D.
"""

import numpy as np
import open3d as o3d


def point_mesh_distances(mesh: o3d.geometry.TriangleMesh, points: np.ndarray) -> np.ndarray:
    """
    Computes distances from points to the element's mesh surface using Open3D RaycastingScene.

    :param mesh: The Open3D TriangleMesh to compute distances to.
    :param points: The point cloud data as a NumPy array.
    :return: A NumPy array of distances from each point to the mesh surface.
    """

    if len(points) == 0:
        return np.array([], dtype=np.float64)

    mesh_t = o3d.t.geometry.TriangleMesh.from_legacy(mesh)
    scene = o3d.t.geometry.RaycastingScene()
    scene.add_triangles(mesh_t)


