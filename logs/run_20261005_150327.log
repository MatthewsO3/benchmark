from pathlib import Path

import ifcopenshell
import ifcopenshell.geom
from tqdm import tqdm


def open_ifc(
    ifc_path: str | Path,
) -> tuple[ifcopenshell.file, ifcopenshell.geom.settings]:
    """
    Opens an IFC file and initializes the geometry settings.

    :param ifc_path: Path to the IFC file.
    :return: A tuple containing the IFC model and geometry settings.
    """

    model = ifcopenshell.open(str(ifc_path))
    settings = ifcopenshell.geom.settings()
    settings.set(settings.USE_WORLD_COORDS, True)
    return model, settings


